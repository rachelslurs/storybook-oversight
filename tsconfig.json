{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0"
  },
  // The demo. `stories` is included so the manifest's react-docgen-typescript
  // pass (which builds its program from the tsconfig `storybook build` resolves
  // at the repo root) can extract JSDoc from the demo components. `.storybook`
  // is omitted: preview.ts imports the built addon, which does not exist when a
  // typecheck runs.
  // The two test configs are named explicitly, matching how each package's
  // tsconfig lists its own config files. They decide how every test runs and
  // were otherwise in no compilation unit at all, so a renamed option after a
  // vitest bump would have passed `pnpm typecheck` and failed at run time.
  "include": ["stories", "vitest.config.ts", "vitest.storybook.config.ts"]
}
